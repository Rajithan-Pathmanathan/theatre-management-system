# Copy to .env for local use. Never commit the real .env file.

# --- Backend (Spring Boot) -------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/theatre
DB_USERNAME=theatre
DB_PASSWORD=theatre

# Generate a real secret for anything beyond local dev, e.g.:
#   openssl rand -base64 48
JWT_SECRET=local-dev-only-secret-change-in-every-real-environment-32chars+
JWT_EXPIRATION_MINUTES=60

CORS_ALLOWED_ORIGINS=http://localhost:5173

# PayHere sandbox credentials (https://sandbox.payhere.lk/merchant/sandbox)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_MODE=sandbox

# --- Frontend (Vite) --------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
